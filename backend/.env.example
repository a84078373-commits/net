SMARTCARE_DB=backend/data/smartcare.sqlite3
SMARTCARE_SPEED_ENABLED=0
SMARTCARE_PUBLIC_ORIGIN=
SMARTCARE_CORS=http://localhost:8080,http://127.0.0.1:8080
# Only after deploying your own public HTTPS origin:
# SMARTCARE_SPEED_ENABLED=1
# SMARTCARE_PUBLIC_ORIGIN=https://your-own-domain.example
# SMARTCARE_CORS=https://your-own-domain.example
# Environment variables must be exported by the service manager; .env is not auto-loaded.

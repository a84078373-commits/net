SMARTCARE_DB=backend/data/smartcare.sqlite3
SMARTCARE_SPEED_ENABLED=0
SMARTCARE_PUBLIC_ORIGIN=
SMARTCARE_CORS=http://localhost:8080,http://127.0.0.1:8080
# Free CARTO basemap key from https://carto.com/basemaps/apikey/
# SMARTCARE_CARTO_API_KEY=your_key_here
# Only after deploying your own public HTTPS origin:
# SMARTCARE_SPEED_ENABLED=1
# SMARTCARE_PUBLIC_ORIGIN=https://your-own-domain.example
# SMARTCARE_CORS=https://your-own-domain.example
# WhatsApp OTP via GREEN-API (https://green-api.com) — or set from Admin → settings
# SMARTCARE_GREEN_API_ENABLED=1
# SMARTCARE_GREEN_API_URL=https://api.greenapi.com
# SMARTCARE_GREEN_API_ID_INSTANCE=your_id_instance
# SMARTCARE_GREEN_API_TOKEN_INSTANCE=your_api_token_instance
# run_web.py loads backend/.env automatically; production should set env vars in the host.
